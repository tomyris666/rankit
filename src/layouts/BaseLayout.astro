---
import ViewTransitions from 'astro/components/ViewTransitions.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object | object[];
  lang?: string;
}

const { title, description, canonical, schema, lang = 'en' } = Astro.props;
const currentPath = Astro.url.pathname;
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || '';
const canonicalUrl = canonical || `${siteUrl}${currentPath}`;
const currentYear = new Date().getFullYear();

const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

const navItems = [
  { href: '/ai-general/the-slopocalypse/', label: 'The Slopocalypse' },
  { href: '/contact/', label: 'Contact' },
];
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content="index, follow" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:locale" content="en_GB" />

  <ViewTransitions />

  {schemas.map((s) => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}

  <style is:global>
    @import '../styles/global.css';
  </style>
</head>
<body>
  <!-- SPA navigation progress bar -->
  <div id="nav-progress" aria-hidden="true"></div>

  <!-- Initial page loader — removed after first hard load via JS -->
  <div id="page-loader" aria-hidden="true">
    <span class="loader-wordmark">RANKIT</span>
  </div>

  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">RANKIT</a>
      <ul class="nav-links">
        {navItems.map(({ href, label }) => (
          <li>
            <a href={href} class={currentPath === href || (href !== '/' && currentPath.startsWith(href)) ? 'active' : ''}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <slot name="footer-bg" />
    <div class="container footer-text-wrap">
      <p class="footer-text">&copy; 2025 Rankit Consultancy</p>
    </div>
  </footer>

  <script>
    // ── Page loader ──
    // astro:after-swap fires on every SPA navigation after the new DOM is in place.
    // The new body contains a fresh #page-loader — remove it instantly so it never blocks.
    document.addEventListener('astro:after-swap', () => {
      const loader = document.getElementById('page-loader');
      if (loader) loader.remove();
    });

    // On the very first hard load there is no swap — hide via astro:page-load instead.
    document.addEventListener('astro:page-load', () => {
      const loader = document.getElementById('page-loader');
      if (!loader) return;
      loader.classList.add('loader-out');
      setTimeout(() => loader.remove(), 550);
    }, { once: true });

    // ── SPA nav progress bar ──
    document.addEventListener('astro:before-preparation', () => {
      const b = document.getElementById('nav-progress');
      if (!b) return;
      b.classList.remove('np-complete');
      b.style.width = '';
      void b.offsetWidth;
      b.classList.add('np-active');
    });

    document.addEventListener('astro:page-load', () => {
      const b = document.getElementById('nav-progress');
      if (!b || !b.classList.contains('np-active')) return;
      b.classList.remove('np-active');
      b.classList.add('np-complete');
      setTimeout(() => b.classList.remove('np-complete'), 550);
    });

    function initScribble() {
      const targets = document.querySelectorAll('.scribble-target');
      if (!targets.length) return;

      // Set up two-span structure: visible + transparent rest (reserves final layout)
      const elements: { el: HTMLElement; container: HTMLElement; text: string; visible: HTMLElement; rest: HTMLElement; cursor: HTMLElement }[] = [];
      targets.forEach((el) => {
        const htmlEl = el as HTMLElement;
        const text = htmlEl.textContent?.trim() || '';
        htmlEl.dataset.scribbleText = text;

        // If there's a .highlight wrapper, type inside it; otherwise type in the element directly
        const highlightSpan = htmlEl.querySelector('.highlight') as HTMLElement | null;
        const container = highlightSpan || htmlEl;
        container.innerHTML = '';

        const visible = document.createElement('span');
        visible.className = 'scribble-vis';

        const cursor = document.createElement('span');
        cursor.className = 'scribble-cursor';

        const rest = document.createElement('span');
        rest.className = 'scribble-rest';
        rest.textContent = text;

        container.appendChild(visible);
        container.appendChild(cursor);
        container.appendChild(rest);

        htmlEl.classList.remove('scribble-hidden', 'scribble-done', 'scribble-typing');
        htmlEl.classList.add('scribble-waiting');
        elements.push({ el: htmlEl, container, text, visible, rest, cursor });
      });

      // Type out elements sequentially — cursor only appears when element starts
      let idx = 0;
      function typeNext() {
        if (idx >= elements.length) return;
        const entry = elements[idx];
        entry.el.classList.remove('scribble-waiting');
        entry.el.classList.add('scribble-typing');
        entry.cursor.classList.add('scribble-cursor-active');
        typeElement(entry, () => {
          entry.cursor.classList.remove('scribble-cursor-active');
          entry.cursor.remove();
          entry.el.classList.remove('scribble-typing');
          entry.el.classList.add('scribble-done');
          idx++;
          if (idx < elements.length) {
            const gap = elements[idx].el.tagName === 'H1' ? 200 : 80;
            setTimeout(typeNext, gap);
          }
        });
      }
      typeNext();
    }

    function typeElement(entry: { el: HTMLElement; text: string; visible: HTMLElement; rest: HTMLElement }, onDone: () => void) {
      const isHeading = entry.el.tagName === 'H1';
      let i = 0;
      const len = entry.text.length;
      const baseDelay = isHeading
        ? (len > 100 ? Math.min(35, 3000 / len) : 35)
        : (len > 100 ? Math.min(12, 1200 / len) : 12);
      const jitter = isHeading ? 15 : 4;

      function tick() {
        if (i < len) {
          i++;
          entry.visible.textContent = entry.text.slice(0, i);
          entry.rest.textContent = entry.text.slice(i);
          const delay = baseDelay + (Math.random() * jitter * 2 - jitter);
          setTimeout(tick, Math.max(8, delay));
        } else {
          // Remove rest span and cursor, keep vis span with full text
          entry.rest.remove();
          onDone();
        }
      }
      tick();
    }

    function initNavScroll() {
      const nav = document.querySelector('.nav') as HTMLElement | null;
      if (!nav) return;
      const update = () => nav.classList.toggle('nav-scrolled', window.scrollY > 20);
      window.addEventListener('scroll', update, { passive: true });
      update();
    }

    // Run on initial load and after each Astro page swap
    document.addEventListener('astro:page-load', () => {
      initScribble();
      initNavScroll();
    });

    // Fallback: if astro:page-load never fires (e.g. ClientRouter script blocked),
    // run once window.load fires — only if elements are still in their initial hidden state
    window.addEventListener('load', () => {
      if (document.querySelector('.scribble-hidden')) {
        initScribble();
      }
    });
  </script>

</body>

<style is:global>
  /* ── Page loader ── */
  #page-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.6rem;
    pointer-events: all;
    transition: opacity 0.45s ease;
  }
  #page-loader.loader-out {
    opacity: 0;
    pointer-events: none;
  }
  .loader-wordmark {
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.35em;
    color: #1a1a1a;
  }
  .loader-wordmark::after {
    content: '_';
    color: #722f37;
    animation: ldr-blink 0.9s step-end infinite;
  }
  @keyframes ldr-blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  /* ── SPA nav progress bar ── */
  #nav-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: #722f37;
    z-index: 10000;
    opacity: 0;
    pointer-events: none;
  }
  #nav-progress.np-active {
    opacity: 1;
    animation: np-grow 0.7s cubic-bezier(0.4, 0, 0.6, 1) forwards;
  }
  #nav-progress.np-complete {
    width: 100% !important;
    animation: none;
    transition: width 0.12s ease, opacity 0.35s ease 0.15s;
    opacity: 0;
  }
  @keyframes np-grow {
    from { width: 0%; }
    to   { width: 82%; }
  }
</style>
</html>
