---
import BaseLayout from '../layouts/BaseLayout.astro';

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Rankit Consultancy",
  "url": "https://rankitconsultancy.com/about/",
  "description": "Rankit Consultancy — search & LLM optimisation, AI integration, and digital product design. Three disciplines, measurable outcomes.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Rankit Consultancy",
    "url": "https://rankitconsultancy.com"
  }
};
---

<BaseLayout
  title="What We Do — Rankit Consultancy"
  description="Rankit Consultancy — search & LLM optimisation, AI integration, and digital product design. Three disciplines, measurable outcomes."
  schema={aboutSchema}
>

  <!-- ── WHAT WE DO ─────────────────────────────────────────────── -->
  <section class="wwd-section">
    <div class="wwd-overlay"></div>

    <div class="wwd-inner">
      <div class="wwd-header">
        <p class="wwd-eyebrow scribble-target scribble-hidden">Our disciplines</p>
        <h1 class="wwd-title scribble-target scribble-hidden">What We Do</h1>
        <p class="wwd-body scribble-target scribble-hidden">
          We work across three interconnected disciplines — each one a specialism in its own right, and more powerful in combination. Whether you need one or all three, we start with your specific situation and build from there.
        </p>
      </div>

      <div class="wwd-cards">
        <a href="#search-llm" class="wwd-card wwd-card-dark wwd-reveal">
          <div class="wwd-card-fill"></div>
          <div class="wwd-card-content">
            <span class="wwd-card-num">01</span>
            <span class="wwd-card-name">Search & LLM<br>Optimisation</span>
            <p class="wwd-card-desc">Visibility across traditional and AI-powered search — built to compound.</p>
            <span class="wwd-card-cta">Explore ↓</span>
          </div>
        </a>

        <a href="#ai-integration" class="wwd-card wwd-card-light wwd-reveal">
          <div class="wwd-card-fill"></div>
          <div class="wwd-card-content">
            <span class="wwd-card-num">02</span>
            <span class="wwd-card-name">AI<br>Integration</span>
            <p class="wwd-card-desc">Operational AI that ships into your workflows and stays working.</p>
            <span class="wwd-card-cta">Explore ↓</span>
          </div>
        </a>

        <a href="#digital-product" class="wwd-card wwd-card-burgundy wwd-reveal">
          <div class="wwd-card-fill"></div>
          <div class="wwd-card-content">
            <span class="wwd-card-num">03</span>
            <span class="wwd-card-name">Digital Product<br>Design</span>
            <p class="wwd-card-desc">From brief to production — strategy, design, and build under one engagement.</p>
            <span class="wwd-card-cta">Explore ↓</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ── SERVICE 01 — SEARCH & LLM OPTIMISATION ──────────────── -->
  <section class="service-block service-dark" id="search-llm">
    <div class="service-num-bg">01</div>
    <div class="service-content">
      <div class="service-header">
        <span class="service-tag">Search & LLM Optimisation</span>
        <span class="service-idx">01 / 03</span>
      </div>
      <h2 class="service-title">
        Visibility across<br>every search surface.
      </h2>
      <div class="service-body-row">
        <p class="service-desc">
          Generative AI has fundamentally changed how people find information. Ranking on Google is no longer sufficient — your business needs to be surfaced, cited, and recommended by AI systems as well as traditional search engines.
        </p>
        <div class="service-detail">
          <p class="service-detail-text">
            We combine rigorous technical SEO with deep knowledge of how large language models retrieve and cite content. The result is a search presence that performs across both conventional rankings and AI-generated responses.
          </p>
          <ul class="service-list">
            <li>Generative Engine Optimisation (GEO)</li>
            <li>LLM citation & retrieval strategy</li>
            <li>Technical SEO architecture</li>
            <li>AI-first content systems</li>
          </ul>
        </div>
      </div>
      <div class="service-footer">
        <div class="service-promise">
          <span class="promise-mark">→</span>
          <span class="promise-text">Presence in both ranked results and AI-generated answers.</span>
        </div>
        <a href="/contact/?service=search-llm" class="service-cta">Enquire about this service</a>
      </div>
    </div>
  </section>

  <!-- ── SERVICE 02 — AI INTEGRATION ──────────────────────────── -->
  <section class="service-block service-light" id="ai-integration">
    <div class="service-num-bg">02</div>
    <div class="service-content">
      <div class="service-header">
        <span class="service-tag service-tag-dark">AI Integration</span>
        <span class="service-idx service-idx-dark">02 / 03</span>
      </div>
      <h2 class="service-title service-title-dark">
        Operational AI<br>built for production.
      </h2>
      <div class="service-body-row">
        <p class="service-desc service-desc-dark">
          The gap between an AI proof-of-concept and a system that reliably improves how a business operates is where most projects stall. We work in that gap — designing, building, and deploying AI that holds up under real conditions.
        </p>
        <div class="service-detail">
          <p class="service-detail-text service-detail-text-dark">
            We start with your workflows, not with the technology. Every integration is scoped against measurable productivity outcomes, built inside your existing stack, and handed over with full documentation and team training.
          </p>
          <ul class="service-list service-list-dark">
            <li>LLM pipeline design & deployment</li>
            <li>Workflow automation</li>
            <li>AI-assisted internal tooling</li>
            <li>Team enablement & knowledge transfer</li>
          </ul>
        </div>
      </div>
      <div class="service-footer service-footer-dark">
        <div class="service-promise">
          <span class="promise-mark promise-mark-dark">→</span>
          <span class="promise-text service-detail-text-dark">Scoped to your workflows. Measured against productivity outcomes.</span>
        </div>
        <a href="/contact/?service=ai-integration" class="service-cta service-cta-dark">Enquire about this service</a>
      </div>
    </div>
  </section>

  <!-- ── SERVICE 03 — DIGITAL PRODUCT DESIGN ──────────────────── -->
  <section class="service-block service-burgundy" id="digital-product">
    <div class="service-num-bg">03</div>
    <div class="service-content">
      <div class="service-header">
        <span class="service-tag">Digital Product Design</span>
        <span class="service-idx">03 / 03</span>
      </div>
      <h2 class="service-title">
        Products designed<br>to perform.
      </h2>
      <div class="service-body-row">
        <p class="service-desc">
          Digital products succeed or fail on the quality of their design and the rigour of their execution. We work across both — from initial product strategy through to shipped software — without the overhead of a traditional agency engagement.
        </p>
        <div class="service-detail">
          <p class="service-detail-text">
            We embed as a design and product team for companies that need to move quickly without compromising on quality. Our work spans product architecture, interface design, and build — with AI capability integrated as a first-class consideration throughout.
          </p>
          <ul class="service-list">
            <li>Product strategy & scope definition</li>
            <li>UX/UI design systems</li>
            <li>Prototype to production</li>
            <li>AI-native product integration</li>
          </ul>
        </div>
      </div>
      <div class="service-footer">
        <div class="service-promise">
          <span class="promise-mark">→</span>
          <span class="promise-text">Strategy, design, and build under one engagement.</span>
        </div>
        <a href="/contact/?service=digital-product" class="service-cta">Enquire about this service</a>
      </div>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────── -->
  <section class="cta-section">
    <div class="cta-inner">
      <p class="cta-label scribble-target scribble-hidden">Get in touch</p>
      <p class="cta-title scribble-target scribble-hidden">Start with a conversation.<br>We'll take it from there.</p>
      <a href="/contact/" class="contact-line scribble-target scribble-hidden">Work with us</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── WHAT WE DO SECTION ── */
  .wwd-section {
    position: relative;
    min-height: 100vh;
    background-image: url('/images/bonzai2.webp');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    display: flex;
    align-items: stretch;
    padding-top: var(--nav-height);
  }

  .wwd-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(10,10,10,0.88) 0%,
      rgba(10,10,10,0.78) 50%,
      rgba(114,47,55,0.35) 100%
    );
    pointer-events: none;
  }

  .wwd-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 5rem 3rem 6rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .wwd-header {
    max-width: 640px;
  }

  .wwd-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    margin-bottom: 1rem;
  }

  .wwd-title {
    font-family: var(--font-mono);
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--color-white);
    margin-bottom: 1.5rem;
    line-height: 1.05;
  }

  .wwd-body {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 400;
    color: rgba(255,255,255,0.6);
    line-height: 1.9;
    max-width: 520px;
  }

  /* ── CARDS ── */
  .wwd-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .wwd-card {
    position: relative;
    overflow: hidden;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.12);
    min-height: 280px;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    /* scroll-reveal: start invisible */
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.6s ease, transform 0.6s ease, border-color 0.3s;
  }

  .wwd-card.wwd-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger */
  .wwd-card:nth-child(2) { transition-delay: 0.12s; }
  .wwd-card:nth-child(3) { transition-delay: 0.24s; }

  .wwd-card:hover { border-color: rgba(255,255,255,0.35); }

  /* The half-painted fill — diagonal gradient sitting behind content */
  .wwd-card-fill {
    position: absolute;
    inset: 0;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  /* Dark card: black fill, diagonal cut */
  .wwd-card-dark .wwd-card-fill {
    background: linear-gradient(135deg,
      rgba(17,17,17,0.92) 0%,
      rgba(17,17,17,0.6) 45%,
      transparent 70%
    );
  }
  .wwd-card-dark:hover .wwd-card-fill {
    background: rgba(17,17,17,0.92);
  }

  /* Light card: white fill, diagonal cut */
  .wwd-card-light .wwd-card-fill {
    background: linear-gradient(135deg,
      rgba(255,255,255,0.18) 0%,
      rgba(255,255,255,0.08) 45%,
      transparent 70%
    );
  }
  .wwd-card-light:hover .wwd-card-fill {
    background: rgba(255,255,255,0.2);
    backdrop-filter: blur(8px);
  }

  /* Burgundy card: diagonal cut */
  .wwd-card-burgundy .wwd-card-fill {
    background: linear-gradient(135deg,
      rgba(114,47,55,0.9) 0%,
      rgba(114,47,55,0.55) 45%,
      transparent 70%
    );
  }
  .wwd-card-burgundy:hover .wwd-card-fill {
    background: rgba(114,47,55,0.92);
  }

  /* Left accent dash */
  .wwd-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    transition: width 0.35s cubic-bezier(0.4,0,0.2,1);
    z-index: 1;
  }
  .wwd-card-dark::before    { background: rgba(255,255,255,0.5); }
  .wwd-card-light::before   { background: rgba(255,255,255,0.8); }
  .wwd-card-burgundy::before { background: rgba(255,200,200,0.6); }
  .wwd-card:hover::before   { width: 5px; }

  .wwd-card-content {
    position: relative;
    z-index: 2;
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    height: 100%;
  }

  .wwd-card-num {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    color: rgba(255,255,255,0.4);
    display: block;
  }

  .wwd-card-name {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--color-white);
    letter-spacing: -0.01em;
    display: block;
    flex: 1;
  }

  .wwd-card-desc {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    color: rgba(255,255,255,0.55);
    line-height: 1.75;
    margin: 0;
  }

  .wwd-card-cta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.45);
    text-transform: uppercase;
    display: block;
    transition: color 0.2s, letter-spacing 0.2s;
  }
  .wwd-card:hover .wwd-card-cta {
    color: rgba(255,255,255,0.9);
    letter-spacing: 0.14em;
  }

  /* ── SERVICE BLOCKS ── */
  .service-block {
    position: relative;
    overflow: hidden;
    padding: 5rem 3rem;
    scroll-margin-top: var(--nav-height);
  }

  .service-dark     { background: var(--color-black); color: var(--color-white); }
  .service-light    { background: var(--color-white); color: var(--color-black); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .service-burgundy { background: var(--color-burgundy); color: var(--color-white); }

  .service-content {
    position: relative;
    z-index: 1;
    max-width: 1040px;
    margin: 0 auto;
  }

  .service-num-bg {
    position: absolute;
    bottom: -1rem;
    right: 1rem;
    font-family: var(--font-mono);
    font-size: clamp(8rem, 20vw, 18rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .service-dark .service-num-bg     { color: rgba(255,255,255,0.04); }
  .service-light .service-num-bg    { color: rgba(0,0,0,0.04); }
  .service-burgundy .service-num-bg { color: rgba(255,255,255,0.07); }

  .service-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255,255,255,0.15);
  }
  .service-light .service-header { border-bottom-color: var(--color-border); }

  .service-tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    border: 1px solid rgba(255,255,255,0.2);
    padding: 0.3em 0.8em;
  }
  .service-tag-dark { color: var(--color-text-muted); border-color: var(--color-border); }

  .service-idx { font-family: var(--font-mono); font-size: 0.58rem; font-weight: 500; letter-spacing: 0.1em; color: rgba(255,255,255,0.35); }
  .service-idx-dark { color: var(--color-text-muted); }

  .service-title {
    font-family: var(--font-mono);
    font-size: clamp(2.2rem, 5vw, 4.5rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-white);
    margin-bottom: 3rem;
  }
  .service-title-dark { color: var(--color-black); }

  .service-body-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-bottom: 3rem;
  }

  .service-desc { font-family: var(--font-mono); font-size: 1rem; font-weight: 400; line-height: 1.8; color: rgba(255,255,255,0.75); }
  .service-desc-dark { color: var(--color-text-body); }

  .service-detail-text { font-family: var(--font-mono); font-size: 0.78rem; line-height: 2; color: rgba(255,255,255,0.55); margin-bottom: 1.5rem; }
  .service-detail-text-dark { color: var(--color-text-muted); }

  .service-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem; }
  .service-list li { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.04em; color: rgba(255,255,255,0.5); padding-left: 1rem; position: relative; }
  .service-list li::before { content: '—'; position: absolute; left: 0; color: rgba(255,255,255,0.25); }
  .service-list-dark li { color: var(--color-text-muted); }
  .service-list-dark li::before { color: var(--color-burgundy) !important; }

  /* ── SERVICE FOOTER ── */
  .service-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.1);
    flex-wrap: wrap;
  }
  .service-footer-dark { border-top-color: var(--color-border); }

  .service-promise { display: flex; align-items: center; gap: 1rem; }
  .promise-mark { font-family: var(--font-mono); font-size: 1.1rem; color: rgba(255,255,255,0.4); flex-shrink: 0; }
  .promise-mark-dark { color: var(--color-burgundy); }
  .promise-text { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 500; letter-spacing: 0.04em; color: rgba(255,255,255,0.5); font-style: italic; }

  .service-cta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-black);
    background: var(--color-white);
    text-decoration: none;
    padding: 0.65em 1.4em;
    border: 1px solid rgba(255,255,255,0.3);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .service-cta:hover { background: var(--color-burgundy); color: var(--color-white); border-color: var(--color-burgundy); }
  .service-cta-dark { color: var(--color-white); background: var(--color-black); border-color: var(--color-black); }
  .service-cta-dark:hover { background: var(--color-burgundy); border-color: var(--color-burgundy); }

  /* ── CTA ── */
  .cta-section { padding: 6rem 3rem; max-width: 1100px; margin: 0 auto; border-top: 1px solid var(--color-border); }
  .cta-inner { max-width: 600px; display: flex; flex-direction: column; gap: 1.5rem; }
  .cta-label { font-family: var(--font-mono); font-size: 0.6rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-text-muted); }
  .cta-title { font-family: var(--font-mono); font-size: clamp(1.6rem, 4vw, 2.8rem); font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; color: var(--color-black); }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .wwd-cards { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 640px) {
    .wwd-inner { padding: 3rem 1.5rem 4rem; gap: 2.5rem; }
    .wwd-cards { grid-template-columns: 1fr; }
    .wwd-card { min-height: 200px; }
    .wwd-card-content { padding: 1.5rem 1.25rem; }

    .service-block { padding: 3.5rem 1.5rem; }
    .service-body-row { grid-template-columns: 1fr; gap: 2rem; }
    .service-footer { flex-direction: column; align-items: flex-start; }
    .service-cta { width: 100%; text-align: center; display: block; }
    .service-num-bg { font-size: clamp(5rem, 30vw, 10rem); }

    .cta-section { padding: 4rem 1.5rem; }
  }
</style>

<script>
  function initWwdReveal() {
    const cards = document.querySelectorAll('.wwd-reveal');
    if (!cards.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('wwd-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );

    cards.forEach((card) => observer.observe(card));
  }

  document.addEventListener('astro:page-load', initWwdReveal);
</script>
