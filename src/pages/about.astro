---
import BaseLayout from '../layouts/BaseLayout.astro';

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Rankit Consultancy",
  "url": "https://rankitconsultancy.com/about/",
  "description": "Rankit Consultancy integrates AI into your business holistically — focused on measurable productivity gains and real deliverables.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Rankit Consultancy",
    "url": "https://rankitconsultancy.com"
  }
};
---

<BaseLayout
  title="About — Rankit Consultancy"
  description="Rankit Consultancy integrates AI into your business holistically — focused on measurable productivity gains and real deliverables."
  schema={aboutSchema}
>

  <div class="inner-page">

    <p class="about-eyebrow scribble-target scribble-hidden">AI Integration Consultancy</p>

    <h1 class="headline scribble-target scribble-hidden">
      AI that works<br>for your business.<br>Not the other way around.
    </h1>

    <p class="description scribble-target scribble-hidden">
      We integrate artificial intelligence into organisations in ways that are practical, balanced, and built around real deliverables — not hype. Every engagement starts with your workflows, your people, and your goals. Then we build from there.
    </p>

    <div class="about-stats scribble-target scribble-hidden">
      <div class="about-stat">
        <span class="about-stat-num">3×</span>
        <span class="about-stat-label">avg. productivity lift</span>
      </div>
      <div class="about-stat">
        <span class="about-stat-num">90d</span>
        <span class="about-stat-label">to first live deliverable</span>
      </div>
      <div class="about-stat">
        <span class="about-stat-num">0</span>
        <span class="about-stat-label">slide decks, no delivery</span>
      </div>
    </div>

    <div class="about-divider scribble-target scribble-hidden"></div>

    <p class="about-section-label scribble-target scribble-hidden">Our approach</p>

    <div class="about-principles scribble-target scribble-hidden">
      <div class="about-principle">
        <p class="about-principle-title">Holistic, not bolt-on.</p>
        <p class="about-principle-body">We map your entire operation before recommending anything. AI applied without context creates new problems. AI applied with understanding creates compounding leverage.</p>
      </div>
      <div class="about-principle">
        <p class="about-principle-title">Deliverables over decks.</p>
        <p class="about-principle-body">Every sprint ends with something usable — a live automation, a changed workflow, measurable hours saved. We move fast, but everything we build is production-ready.</p>
      </div>
      <div class="about-principle">
        <p class="about-principle-title">Balanced transformation.</p>
        <p class="about-principle-body">Human judgement and machine capability are not rivals. We pace change to match your team's capacity to absorb it — momentum without overwhelm.</p>
      </div>
    </div>

    <div class="about-divider scribble-target scribble-hidden"></div>

    <p class="about-section-label scribble-target scribble-hidden">How it works</p>

    <div class="about-steps scribble-target scribble-hidden">
      <div class="about-step">
        <span class="about-step-num">01</span>
        <div>
          <p class="about-step-title">Opportunity Audit</p>
          <p class="about-step-body">We identify where AI creates the clearest ROI in your workflows before any commitment is made.</p>
        </div>
      </div>
      <div class="about-step">
        <span class="about-step-num">02</span>
        <div>
          <p class="about-step-title">Integration Roadmap</p>
          <p class="about-step-body">A prioritised, phased plan with concrete deliverables, success metrics, and realistic timelines.</p>
        </div>
      </div>
      <div class="about-step">
        <span class="about-step-num">03</span>
        <div>
          <p class="about-step-title">Live Implementation</p>
          <p class="about-step-body">We build and deploy alongside your team — automations, AI-assisted workflows, custom tooling.</p>
        </div>
      </div>
      <div class="about-step">
        <span class="about-step-num">04</span>
        <div>
          <p class="about-step-title">Knowledge Transfer</p>
          <p class="about-step-body">Documented gains, trained team, clear playbook. When we leave, the expertise stays with you.</p>
        </div>
      </div>
    </div>

    <a href="/contact/" class="contact-line scribble-target scribble-hidden">Work with us</a>

  </div>

</BaseLayout>

<style>
  .about-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .about-stats {
    display: flex;
    gap: 3rem;
    margin: 2.5rem 0;
    flex-wrap: wrap;
  }

  .about-stat {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .about-stat-num {
    font-family: var(--font-mono);
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--color-burgundy);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .about-stat-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .about-divider {
    width: 2rem;
    height: 1px;
    background: var(--color-border);
    margin: 2.5rem 0;
  }

  .about-section-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
  }

  .about-principles {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .about-principle-title {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-black);
    margin-bottom: 0.4rem;
    letter-spacing: -0.01em;
  }

  .about-principle-body {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--color-text-body);
    line-height: 1.9;
    max-width: 520px;
  }

  .about-steps {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .about-step {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .about-step-num {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-burgundy);
    padding-top: 0.15rem;
    flex-shrink: 0;
    min-width: 1.8rem;
  }

  .about-step-title {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-black);
    margin-bottom: 0.25rem;
    letter-spacing: 0.01em;
  }

  .about-step-body {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-text-muted);
    line-height: 1.8;
    max-width: 460px;
  }

  .inner-page .contact-line {
    margin-top: 2.5rem;
  }
</style>
