---
import BaseLayout from '../layouts/BaseLayout.astro';

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Rankit Consultancy",
  "url": "https://rankitconsultancy.com/about/",
  "description": "Rankit Consultancy cuts through AI hype and delivers real productivity gains — measurable, fast, and built to last.",
  "mainEntity": {
    "@type": "Organization",
    "name": "Rankit Consultancy",
    "url": "https://rankitconsultancy.com"
  }
};
---

<BaseLayout
  title="About — Rankit Consultancy"
  description="Rankit Consultancy cuts through AI hype and delivers real productivity gains — measurable, fast, and built to last."
  schema={aboutSchema}
>

  <div class="about-wrap">

    <div class="about-top">
      <p class="about-label scribble-target scribble-hidden">AI Integration Consultancy</p>

      <h1 class="about-headline scribble-target scribble-hidden">
        Most AI projects<br>don't deliver.<br>Ours do.
      </h1>
    </div>

    <div class="about-body">

      <p class="about-lead scribble-target scribble-hidden">
        Companies are drowning in pilots that go nowhere, chatbots nobody uses, and automation that breaks every Tuesday. We exist to end that.
      </p>

      <p class="about-text scribble-target scribble-hidden">
        Rankit is an AI integration consultancy. We map your actual workflows, identify where AI creates the clearest leverage, then build and deploy it — inside your team, with your data, against real deadlines. No vendor lock-in. No endless retainers. No slide decks as deliverables.
      </p>

      <div class="about-manifesto scribble-target scribble-hidden">
        <div class="manifesto-line">
          <span class="manifesto-num">01</span>
          <span class="manifesto-rule">Deliverables in 90 days or we've failed.</span>
        </div>
        <div class="manifesto-line">
          <span class="manifesto-num">02</span>
          <span class="manifesto-rule">Your team runs it. We make sure of that.</span>
        </div>
        <div class="manifesto-line">
          <span class="manifesto-num">03</span>
          <span class="manifesto-rule">If productivity didn't move, it doesn't count.</span>
        </div>
      </div>

      <p class="about-close scribble-target scribble-hidden">
        We work with founders and operators who are done waiting for AI to pay off.
      </p>

      <a href="/contact/" class="contact-line scribble-target scribble-hidden">Work with us</a>

    </div>

  </div>

</BaseLayout>

<style>
  .about-wrap {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 3rem;
    padding-top: var(--nav-height);
    gap: 4rem;
  }

  .about-top {
    position: sticky;
    top: calc(var(--nav-height) + 3rem);
    padding: 4rem 0 4rem 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .about-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .about-headline {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-black);
    letter-spacing: -0.03em;
  }

  .about-body {
    padding: 4rem 0 6rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    border-left: 1px solid var(--color-border);
    padding-left: 4rem;
  }

  .about-lead {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.75;
    color: var(--color-black);
    letter-spacing: -0.01em;
  }

  .about-text {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 400;
    line-height: 2;
    color: var(--color-text-body);
    letter-spacing: 0.01em;
  }

  .about-manifesto {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin: 1rem 0;
    border-top: 1px solid var(--color-border);
  }

  .manifesto-line {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .manifesto-num {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-burgundy);
    flex-shrink: 0;
    min-width: 1.5rem;
  }

  .manifesto-rule {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-black);
    line-height: 1.5;
    letter-spacing: 0.01em;
  }

  .about-close {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.8;
    color: var(--color-text-muted);
    letter-spacing: 0.01em;
  }

  @media (max-width: 768px) {
    .about-wrap {
      grid-template-columns: 1fr;
      padding: 0 1.5rem;
      padding-top: var(--nav-height);
      gap: 0;
    }

    .about-top {
      position: static;
      padding: 2.5rem 0 1.5rem;
    }

    .about-headline {
      font-size: clamp(1.8rem, 8vw, 2.4rem);
    }

    .about-body {
      border-left: none;
      border-top: 1px solid var(--color-border);
      padding-left: 0;
      padding-top: 2rem;
      padding-bottom: 4rem;
    }
  }
</style>

</BaseLayout>
