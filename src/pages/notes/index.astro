---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { notesTree, getAllArticles } from '../../data/notes-tree';

const allArticles = getAllArticles();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Notes — Rankit Consultancy',
  description: 'Knowledge base covering SEO, content strategy, analytics, and digital marketing.',
  url: 'https://rankitconsultancy.com/notes/',
};
---
<BaseLayout
  title="Notes — Rankit Consultancy"
  description="Knowledge base covering SEO, content strategy, analytics, and digital marketing."
  schema={schema}
>
  <div class="notes-page container">
    <aside class="tree-sidebar" id="tree-sidebar">
      <button class="tree-mobile-toggle" id="tree-mobile-toggle" aria-expanded="false" aria-controls="tree-sidebar">
        <span class="tree-mobile-toggle-icon">▶</span> Browse Notes
      </button>
      <nav class="tree-nav" id="tree-nav" aria-label="Notes navigation">
        {notesTree.map((cat) => (
          <div class="tree-branch" data-category={cat.slug}>
            <button class="tree-toggle" aria-expanded="true" data-slug={cat.slug}>
              <span class="tree-chevron">▶</span>
              <span class="tree-toggle-label">{cat.name}</span>
            </button>
            <div class="tree-children tree-children-open" aria-hidden="false">
              {cat.children?.map((sub) => (
                <div class="tree-branch tree-branch-nested" data-category={sub.slug}>
                  <button class="tree-toggle tree-toggle-sub" aria-expanded="false" data-slug={sub.slug}>
                    <span class="tree-chevron">▶</span>
                    <span class="tree-toggle-label">{sub.name}</span>
                  </button>
                  <div class="tree-children tree-articles" aria-hidden="true">
                    {sub.articles?.map((article) => {
                      const articlePath = `/${sub.slug}/${article.slug}/`;
                      return (
                        <a class="tree-article-link" href={articlePath} data-slug={article.slug}>
                          {article.title}
                        </a>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </nav>
    </aside>

    <section class="notes-content" id="notes-content">
      <div class="notes-welcome" id="notes-welcome">
        <p class="description scribble-target">A growing knowledge base of practical guides, checklists, and deep dives across digital marketing, SEO, analytics, and content strategy.</p>
      </div>

      <div class="notes-search-wrapper">
        <input
          type="search"
          id="notes-search"
          class="notes-search"
          placeholder="Search articles..."
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <div class="notes-filter-row">
        <button class="notes-filter-btn" data-filter="digital marketing">Digital Marketing</button>
        <button class="notes-filter-btn" data-filter="artificial intelligence">Artificial Intelligence</button>
      </div>

      <div id="notes-all-cards" class="search-results">
        {allArticles.map(({ article, path, categoryPath }) => {
          const parentName = categoryPath[0] || '';
          const leafName = categoryPath[categoryPath.length - 1] || '';
          return (
            <a
              href={path}
              class="search-result-card"
              data-title={article.title}
              data-tags={categoryPath.join(' ').toLowerCase()}
            >
              <img
                src={article.image || '/images/article-default.svg'}
                alt=""
                class="search-result-card-image"
                loading="lazy"
                style={article.imagePosition ? `object-position: ${article.imagePosition}` : undefined}
              />
              <div class="search-result-card-body">
                <div class="search-result-meta">
                  <span class="search-result-tag">{parentName}</span>
                  {leafName !== parentName && <span class="search-result-tag">{leafName}</span>}
                </div>
                <p class="search-result-title">{article.title}</p>
                <p class="search-result-summary">{article.summary}</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </div>

  <script>
    let notesAbort: AbortController | null = null;

    function initNotes() {
      notesAbort?.abort();
      notesAbort = new AbortController();
      const { signal } = notesAbort;

      const sidebar = document.getElementById('tree-sidebar');
      const mobileToggle = document.getElementById('tree-mobile-toggle');

      // Mobile sidebar toggle
      mobileToggle?.addEventListener('click', () => {
        const expanded = mobileToggle.getAttribute('aria-expanded') === 'true';
        mobileToggle.setAttribute('aria-expanded', String(!expanded));
        sidebar?.classList.toggle('tree-sidebar-open');
        const icon = mobileToggle.querySelector('.tree-mobile-toggle-icon');
        if (icon) icon.textContent = expanded ? '▶' : '▼';
      }, { signal });

      // Tree expand/collapse
      document.querySelectorAll('#tree-nav .tree-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          const children = btn.nextElementSibling as HTMLElement | null;
          if (children) {
            children.setAttribute('aria-hidden', String(expanded));
            children.classList.toggle('tree-children-open', !expanded);
          }
        }, { signal });
      });

      // Search + filter
      const searchInput = document.getElementById('notes-search') as HTMLInputElement | null;
      const allCards = Array.from(
        document.querySelectorAll('#notes-all-cards .search-result-card')
      ) as HTMLElement[];
      const filterBtns = Array.from(
        document.querySelectorAll('.notes-filter-btn')
      ) as HTMLButtonElement[];

      let activeFilter = '';

      function applyFilters() {
        const q = searchInput ? searchInput.value.trim().toLowerCase() : '';
        allCards.forEach((card) => {
          const title = (card.dataset.title || '').toLowerCase();
          const tags = (card.dataset.tags || '').toLowerCase();
          const matchesText = !q || title.includes(q) || tags.includes(q);
          const matchesFilter = !activeFilter || tags.includes(activeFilter);
          card.hidden = !(matchesText && matchesFilter);
        });
      }

      searchInput?.addEventListener('input', applyFilters, { signal });

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const f = btn.dataset.filter || '';
          if (activeFilter === f) {
            activeFilter = '';
            btn.classList.remove('notes-filter-active');
          } else {
            activeFilter = f;
            filterBtns.forEach((b) => b.classList.remove('notes-filter-active'));
            btn.classList.add('notes-filter-active');
          }
          applyFilters();
        }, { signal });
      });
    }

    document.addEventListener('astro:page-load', initNotes);
  </script>
</BaseLayout>
